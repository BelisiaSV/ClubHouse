# Leave unset for local dev — src/api/client.js falls back to relative
# paths, proxied to the backend by Vite's dev server (see vite.config.js).
# Set this to the deployed backend's own origin when running against a
# separately-deployed backend (e.g. a Vercel project URL), with no
# trailing slash: https://clubhouse-backend.vercel.app
VITE_API_BASE_URL=
