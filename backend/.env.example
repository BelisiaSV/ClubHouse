DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/clubhouse
JWT_SECRET_KEY=change-me-in-production

# Password reset emails. If SMTP_HOST is unset, reset links are logged to the
# server console instead of being emailed (useful for local dev).
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clubhouse.local

# Platform admin bootstrap (python seed_platform_admin.py) — never exposed via
# a public API endpoint, see the "Platform admin" section of the README.
PLATFORM_ADMIN_EMAIL=jordy@clubhouse.local
PLATFORM_ADMIN_PASSWORD=changeme123
PLATFORM_ADMIN_FULL_NAME=Jordy

# Comma-separated list of frontend origins allowed to call this API. Only
# needs to be set in deployed environments — defaults to the local Vite dev
# server. See "Deploying to Vercel + Supabase" in the README.
ALLOWED_ORIGINS=http://localhost:5173

# Club logo storage. Leave both unset for local dev (logos are written to
# backend/static/ and served from there instead) — set both when deploying
# to Vercel, whose filesystem can't durably store uploads. Needs a public
# Supabase Storage bucket named to match SUPABASE_STORAGE_BUCKET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=club-logos
